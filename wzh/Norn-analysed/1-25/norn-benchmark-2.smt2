(declare-fun x () String)


(assert (str.in_re "" 
    (re.* (re.range "a" "u")
)))

;上面的式子是永真式，不管


(assert (
    str.in_re 
        x 
        (re.* 
            (re.union 
                (str.to_re "a") 
                (str.to_re "b")
))))

(assert (not 
    (str.in_re 
        x 
        (re.* 
            (re.range "a" "u")
))))

;这前几个设计全部根据同一个导致循环的问题，这不是2015的benchmark吗，怎么2025了求解器还没改这玩意

(check-sat)
(exit)
