(set-logic ALL)
(declare-fun div1_b_0 () Bool)
(declare-fun div1_x_1 () String)
(declare-fun div1_x_0 () String)
(declare-fun div1_last () String)
(declare-fun div1_split () String)
(declare-fun email_div1 () String)
(declare-fun div1_num () Int)
(declare-fun div2_r_1 () String)
(declare-fun div2_b_1 () Bool)
(declare-fun div2_b_0 () Bool)
(declare-fun div2_x_1 () String)
(declare-fun div2_x_0 () String)
(declare-fun div2_last () String)
(declare-fun div1_b_1 () Bool)
(declare-fun div2_split () String)
(declare-fun domain_div2 () String)
(declare-fun div2_num () Int)
(declare-fun tld () String)
(declare-fun domain_name () String)
(declare-fun domain () String)
(declare-fun local_part () String)
(declare-fun email () String)
(assert (= div1_num 2))
(assert (= local_part div1_x_0))
(assert (= div1_x_1 domain))
(assert (> (str.len local_part) 0))
(assert (>= div2_num 2))
(assert (= div2_x_0 domain_name))
(assert (= div2_r_1 tld))
(assert (> (str.len domain_name) 0))
(assert (>= (str.len tld) 2))
(assert (<= (str.len tld) 6))
(assert (str.in_re tld (re.++ (re.* (re.union (re.range "a" "z") (re.range "A" "Z"))) (str.to_re ""))))
(assert (not (str.contains local_part "@")))
(assert (not (str.contains local_part " ")))
(assert (not (str.prefixof "." domain)))
(assert (not (str.suffixof "." domain)))
(assert (= email "user.name@example.com"))
(assert (= (str.replace_all domain "." "\\u{2FFFF}") domain_div2))
(assert (= (str.++ div2_split div2_last) domain_div2))
(assert (or (str.prefixof "\\u{2FFFF}" div2_last) (= div2_last "")))
(assert (not (str.contains domain "\\u{2FFFF}")))
(assert (= div2_b_0 (= div2_split div2_x_0)))
(assert (= div2_b_1 (= div2_split (str.++ div2_x_0 "\\u{2FFFF}" div2_x_1))))
(assert (= div2_num (- (str.len domain_div2) (str.len (str.replace_all domain_div2 "\\u{2FFFF}" "")))))
(assert (= (str.replace_all email "@" "\\u{2FFFF}") email_div1))
(assert (= (str.++ div1_split div1_last) email_div1))
(assert (or (= "" div1_last) (str.prefixof "\\u{2FFFF}" div1_last)))
(assert (not (str.contains email "\\u{2FFFF}")))
(assert (= div1_b_0 (= div1_split div1_x_0)))
(assert (= (= div1_split (str.++ div1_x_0 "\\u{2FFFF}" div1_x_1)) div1_b_1))
(assert (= (- (str.len email_div1) (str.len (str.replace_all email_div1 "\\u{2FFFF}" ""))) div1_num))
(assert (=> (= div2_x_0 domain_name) (or div2_b_1 div2_b_0)))
(assert (=> (= div2_r_1 tld) div2_b_1))
(assert (=> div2_b_1 (= (str.replace_all div2_r_1 "." "x0ðx0¯x0¿x0¿") (str.++ div2_x_1 div2_last))))
(assert (=> (= local_part div1_x_0) (or div1_b_0 div1_b_1)))
(assert (=> (= div1_x_1 domain) div1_b_1))
(check-sat)
(exit)
