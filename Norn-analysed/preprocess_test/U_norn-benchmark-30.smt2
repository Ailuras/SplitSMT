(declare-const v Int)

(declare-fun x4 () String)
(assert
    (str.in_re
        x4
        (re.* (re.range "a" "u"))
    )
)
(assert
    (str.in_re
        x4
        (re.++
            (re.* (str.to_re "a"))
            (str.to_re "b")
            (re.* (str.to_re "b"))
        )
    )
)
(assert (not
    (str.in_re
        (str.++
            "a"
            x4
            "b"
        )
        (re.++
            (re.* (str.to_re "a"))
            (str.to_re "b")
            (re.* (str.to_re "b"))
        )
    )
))
(assert
    (and
        (<= 0 (str.len x4))
        (= (* v 2) (+ (str.len x4) 2))
    )
)
(assert
    (str.in_re
        x4
        (re.* (re.range "a" "u"))
    )
)
(assert
    (str.in_re
        x4
        (re.++
            (re.* (str.to_re "a"))
            (str.to_re "b")
            (re.* (str.to_re "b"))
        )
    )
)
(assert
    (and
        (<= 0 (str.len x4))
        (= (* v 2) (+ (str.len x4) 2))
    )
)
(assert (not
    (str.in_re
        (str.++
            x4
            "b"
        )
        (re.++
            (str.to_re "b")
            (re.* (str.to_re "b"))
        )
    )
))
(check-sat)
(exit)
