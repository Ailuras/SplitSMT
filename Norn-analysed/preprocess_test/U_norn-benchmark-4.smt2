(declare-fun x1 () String)
(assert
    (str.in_re
        x1
        (re.* (re.union
            (str.to_re "a")
            (str.to_re "b")
        ))
    )
)
(assert (not
    (str.in_re
        x1
        (re.* (re.range "a" "b"))
    )
))
(check-sat)
(exit)

