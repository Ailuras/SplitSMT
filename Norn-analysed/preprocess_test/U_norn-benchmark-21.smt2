(declare-fun x4 () String)

(assert
    (str.in_re
        x4
        (re.* (re.range "a" "c"))
    )
)
(assert
    (str.in_re
        x4
        (re.* (re.union
            (str.to_re "a")
            (str.to_re "b")
            (str.to_re "c")
        ))
    )
)
(assert (not
    (str.in_re
        x4
        (re.union
            (re.++
                (str.to_re "b")
                (re.* (re.union
                    (str.to_re "b")
                    (str.to_re "a")
                    (str.to_re "c")
                ))
            )
            (re.++
                (str.to_re "a")
                (re.* (re.union
                    (str.to_re "b")
                    (str.to_re "a")
                    (str.to_re "c")
                ))
            )
            (re.++
                (str.to_re "c")
                (re.* (re.union
                    (str.to_re "b")
                    (str.to_re "a")
                    (str.to_re "c")
                ))
            )
        )
    )
))
(check-sat)
(exit)
