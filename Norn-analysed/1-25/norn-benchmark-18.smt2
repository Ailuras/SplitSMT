(declare-fun x10 () String)
(assert
    (str.in_re ; x10 in za*
        x10
        (re.++
            (str.to_re "z")
            (str.to_re "a")
            (re.* (str.to_re "aa"))
        )
    )
)
(assert (not ; x10 + 'a' not in [z|a(a)*z]* + a + a*
    (str.in_re
        x10
        (re.++
            (str.to_re "z")
            (re.* (str.to_re "a"))
        )
    )
))
(check-sat)
(exit)
