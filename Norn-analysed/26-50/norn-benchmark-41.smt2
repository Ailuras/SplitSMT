(declare-fun x9 () String)
(assert
    (str.in_re
        x9
        (re.* (str.to_re "a"))
    )
)
(assert (not
    (str.in_re
        x9
        (re.++
            (re.* (re.union
                (str.to_re "a")
                (re.++
                    (str.to_re "b")
                    (re.* (re.union
                        (str.to_re "z")
                        (str.to_re "a")
                    ))
                    (str.to_re "b")
                )
            ))
            (re.* (re.union
                (str.to_re "z")
                (str.to_re "a")
            ))
        )
    )
))
(check-sat)

(exit)

