(declare-fun x_10 () String)
(assert
    (str.in_re
        x_10
        (re.* (re.range "a" "c"))
    )
)
(assert (not
    (str.in_re
        (str.++; a + z + x10 not in [zac]* + ["" | b + [bac]*]
            "a"
            "z"
            x_10
        )
        (re.++
            (re.* (re.union
                (str.to_re "z")
                (str.to_re "a")
                (str.to_re "c")
            ))
            (re.union
                (str.to_re "")
                (re.++
                    (str.to_re "b")
                    (re.* (re.union
