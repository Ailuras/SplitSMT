(set-logic ALL)
(declare-const s String)
(assert (= s "alpha,beta|gamma"))
(assert (= (str.split_at s "," 0) "alpha"))
(assert (= (str.split_at s "," 1) "beta|gamma"))
(assert (= (str.split_rest s "," 1) "beta|gamma"))
(assert (= (str.split_rest s "|" 1) "gamma"))
(assert (= (str.num_splits s ",") 2))
(assert (= (str.num_splits s "|") 2))
(check-sat)
(get-model)
