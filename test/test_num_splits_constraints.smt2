(set-logic ALL)
(declare-const payload String)
(declare-const parts Int)
(assert (= payload "env;prod;active"))
(assert (= parts (str.num_splits payload ";")))
(assert (ite (> parts 1)
             (= (str.split_at payload ";" 0) "env")
             false))
(assert (= (str.split_rest payload ";" 1) "prod;active"))
(check-sat)
(get-model)
