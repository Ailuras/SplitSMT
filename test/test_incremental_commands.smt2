(set-logic ALL)
(declare-const token String)
(assert (= (str.split_at token "-" 0) "session"))
(push 1)
(assert (= (str.split_rest token "-" 1) "id-42"))
(assert (= (str.num_splits token "-") 3))
(check-sat)
(get-model)
(get-value (token))
(pop 1)
(assert (= (str.num_splits token "-") 1))
(check-sat)
(exit)
