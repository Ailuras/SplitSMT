(set-logic ALL)
(declare-const url String)
(assert (= (str.split_at url ":" 0) "scheme"))
(assert (= (str.split_rest url ":" 1) "//example.org/path"))
(assert (= (str.split_at url "/" 2) "example.org"))
(assert (= (str.num_splits url ":") 2))
(assert (= (str.num_splits url "/") 4))
(check-sat)
(get-model)
