(set-logic ALL)
(declare-fun div1_p_2 () Int)
(declare-fun div1_p_1 () Int)
(declare-fun div1_p_0 () Int)
(declare-fun div1_g_1 () Bool)
(declare-fun div1_g_0 () Bool)
(declare-fun div1_r_1 () String)
(declare-fun div1_b_1 () Bool)
(declare-fun div1_x_1 () String)
(declare-fun div1_x_0 () String)
(declare-fun div1_last () String)
(declare-fun div1_split () String)
(declare-fun payload_div1 () String)
(declare-fun parts () Int)
(declare-fun payload () String)
(assert (= "env;prod;active" payload))
(assert (= "prod;active" div1_r_1))
(assert (= payload_div1 (str.replace_re_all payload (str.to_re ";") "#")))
(assert (= (str.++ div1_split div1_last) payload_div1))
(assert (or (= "" div1_last) (str.prefixof "#" div1_last)))
(assert (= (= div1_split (str.++ div1_x_0 "#" div1_x_1)) div1_b_1))
(assert (= div1_p_0 (- 1)))
(assert (= (str.indexof div1_split "#" (+ 1 div1_p_0)) div1_p_1))
(assert (= (or (= div1_p_1 (- 1)) (= (- (- div1_p_1 div1_p_0) 1) (str.len div1_x_0))) div1_g_0))
(assert (= div1_p_2 (str.indexof div1_split "#" (+ 1 div1_p_1))))
(assert (= div1_g_1 (or (= div1_p_2 (- 1)) (= (str.len div1_x_1) (- (- div1_p_2 div1_p_1) 1)))))
(assert (=> div1_b_1 (and div1_g_1 div1_g_0)))
(assert (=> (= "prod;active" div1_r_1) div1_b_1))
(assert (=> div1_b_1 (= (str.++ div1_x_1 div1_last) (str.replace_re_all div1_r_1 (str.to_re ";") "#"))))
(check-sat)
(exit)