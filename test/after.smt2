(set-logic ALL)
(declare-fun s () String)
(assert (= s "alpha,beta|gamma"))
(assert (= "alpha" (str.split_at s "," 0)))
(assert (= "beta|gamma" (str.split_at s "," 1)))
(assert (= (str.split_rest s "," 1) "beta|gamma"))
(assert (= "gamma" (str.split_rest s "|" 1)))
(assert (= (str.num_splits s ",") 2))
(assert (= (str.num_splits s "|") 2))
(check-sat)
(exit)