(set-logic QF_SLIA)
(declare-fun div_length_before () Int)
(declare-fun div_last () String)
(declare-fun div_split () String)
(declare-fun div_num_splits () Int)
(declare-fun div_length_after () Int)
(declare-fun div_split_0 () String)
(declare-fun temp () String)
(declare-fun input () String)
(assert (distinct div_num_splits 1))
(assert (= (str.++ div_split div_last) input))
(assert (or (str.prefixof "/" div_last) (= "" div_last)))
(assert (not (str.contains div_split_0 "/")))
(assert (= div_length_before (str.len input)))
(assert (= (str.len (str.replace_all input "/" "")) div_length_after))
(assert (= div_num_splits (div (- div_length_before div_length_after) 1)))
(assert (>= div_num_splits 1))
(check-sat)
(get-model)
(exit)