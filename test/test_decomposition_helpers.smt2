(set-logic ALL)
(declare-const data String)
(define-fun get_split_length ((x String) (d String) (limit Int)) Int
  (ite (> limit 0)
       (ite (< (str.num_splits x d) limit)
            (str.num_splits x d)
            limit)
       (str.num_splits x d)))
(define-fun get_split_element ((x String) (d String) (limit Int) (i Int)) String
  (ite (and (> limit 0)
            (= i (- limit 1))
            (>= (str.num_splits x d) limit))
       (str.split_rest x d (- limit 1))
       (str.split_at x d i)))
(assert (= data "user:name:metadata"))
(assert (= (get_split_length data ":" 2) 2))
(assert (= (get_split_length data ":" -1) 3))
(assert (= (get_split_element data ":" 2 1) "name:metadata"))
(assert (= (get_split_element data ":" -1 2) "metadata"))
(check-sat)
