(assert (= (str.split_at x "a" 1) x_part2))
(assert (= (str.len x_part1) 1))
(assert (= (str.len x_part2) 3))
(assert (= (str.split_at y "a" 0) y_part1))
(assert (= (str.split_at y "a" 1) y_part2))
(assert (>= (str.len y_part1) 2))
(assert (>= (str.len y_part2) 2))
(assert (str.in_re y_part1 (re.* (str.to_re "bb"))))
(assert (str.in_re y_part2 (re.* (str.to_re "aa"))))
