(declare-const x String)
(declare-const y String)
(assert (str.in_re x (str.to_re "bbaa")))
(assert (str.in_re y (re.* (str.to_re "bbaa"))))
(assert (= 4 (str.len x)))
(assert (= (str.len y) 8))

; --- LLM Generated Split Constraints ---
(declare-const x_split_count Int)
(declare-const y_split_count Int)
(declare-const x_first_split String)
(declare-const y_first_split String)
(assert (= (str.num_splits x "aa") x_split_count))
(assert (= (str.num_splits y "aa") y_split_count))
(assert (= x_split_count 1))
(assert (> y_split_count 1))
(assert (= (str.split_at x "aa" 0) x_first_split))
(assert (= (str.split_at y "aa" 0) y_first_split))
(assert (= x_first_split "bb"))
(assert (str.in_re y_first_split (re.* (str.to_re "bb"))))
; --- End LLM Generated Constraints ---

(check-sat)

