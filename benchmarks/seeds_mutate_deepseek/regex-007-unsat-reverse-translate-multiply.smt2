(declare-const x String)
(assert (= (str.len x) 16))
(assert (str.in_re x (re.* (str.to_re "yyffDD"))))
(assert (str.in_re x (re.* (str.to_re "yyDDvv''\\\\rr''"))))

; --- LLM Generated Split Constraints ---
(declare-const num_splits_ff Int)
(declare-const first_split_ff String)
(declare-const second_split_ff String)
(assert (= (str.num_splits x "ff") num_splits_ff))
(assert (>= num_splits_ff 1))
(assert (= (str.split_at x "ff" 0) first_split_ff))
(assert (= (str.split_at x "ff" 1) second_split_ff))
(assert (str.in_re first_split_ff (re.* (re.union (str.to_re "yy") (str.to_re "DD")))))
(assert (str.contains second_split_ff "DD"))
(declare-const num_splits_rr Int)
(declare-const first_split_rr String)
(assert (= (str.num_splits x "\\\\rr''") num_splits_rr))
(assert (<= num_splits_rr 2))
(assert (= (str.split_at x "\\\\rr''" 0) first_split_rr))
(assert (str.in_re first_split_rr (re.* (str.to_re "yy"))))
(declare-const num_splits_vv Int)
(assert (= (str.num_splits x "vv") num_splits_vv))
(assert (>= num_splits_vv 1))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
