(assert (= (str.split_at x "|" 1) x_suffix))
(assert (= (str.split_at y "," 0) y_prefix))
(assert (= (str.split_at y "," 1) y_suffix))
(assert (str.in_re x_prefix (re.+ (str.to_re "tK*!"))))
(assert (str.in_re x_suffix (re.+ (str.to_re "vu|E,.a\"'1@H#Z6k"))))
