(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (str.to_re "t'GP_'\\x0c'n'p'\\n'8*pi5"))))
(assert (str.in_re y (re.* (re.+ (str.to_re "AS\\\\JV'\\t'Iwmdf12")))))
(assert (= (str.len x) 5))
(assert (= (str.len y) 9))

; --- LLM Generated Split Constraints ---
(declare-const x_num_splits Int)
(declare-const y_num_splits Int)
(declare-const x_split_part1 String)
(declare-const x_split_part2 String)
(declare-const y_split_part1 String)
(declare-const y_split_part2 String)
(assert (= (str.num_splits x "\\x0c") x_num_splits))
(assert (= (str.num_splits y "\\t") y_num_splits))
(assert (or (= x_num_splits 1) (= x_num_splits 2)))
(assert (or (= y_num_splits 1) (= y_num_splits 2)))
(assert (= (str.split_at x "\\x0c" 0) x_split_part1))
(assert (<= (str.len x_split_part1) 4))
(assert (= (str.split_at y "\\t" 0) y_split_part1))
(assert (<= (str.len y_split_part1) 8))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
