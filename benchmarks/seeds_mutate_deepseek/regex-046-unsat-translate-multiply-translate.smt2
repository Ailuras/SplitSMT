(= (str.split_at x "Y" 1) second_Y)
(assert (<= (str.len first_Y) 1))
(assert (<= (str.len second_Y) 1))
(assert (str.in_re first_Y (re.opt (str.to_re "Y"))))
(assert (str.in_re second_Y (re.opt (str.to_re "Y"))))
; --- End LLM Generated Constraints ---

