(assert (str.in_re before_quote (re.* (str.to_re "C"))))
(assert (or (= after_quote "") (not (= after_quote ""))))
(assert (=> (not (= after_quote "")) (= (str.len x) (+ (str.len before_quote) (str.len after_quote) 1))))
