(declare-const x String)
(declare-const y String)
(declare-const m String)
(declare-const n String)
(assert (= (str.++ x y) (str.++ m n)))
(assert (str.in_re n (re.* (str.to_re ""))))
(assert (> (str.len x) (str.len m)))

; --- LLM Generated Split Constraints ---
(declare-const num_concat_parts Int)
(declare-const x_part String)
(declare-const y_part String)
(declare-const m_part String)
(declare-const n_part String)
(assert (= (str.num_splits (str.++ x y) "") num_concat_parts))
(assert (= num_concat_parts 2))
(assert (= (str.split_at (str.++ x y) "" 0) x_part))
(assert (= (str.split_at (str.++ x y) "" 1) y_part))
(assert (= (str.split_at (str.++ m n) "" 0) m_part))
(assert (= (str.split_at (str.++ m n) "" 1) n_part))
(assert (= x_part x))
(assert (= y_part y))
(assert (= m_part m))
(assert (= n_part n))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
