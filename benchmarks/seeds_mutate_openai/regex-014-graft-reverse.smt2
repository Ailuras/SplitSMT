(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.* (str.to_re "ba"))))
(assert (str.in_re y (str.to_re "ba")))
(assert (= 2 (str.len x)))
(assert (= (str.len y) 4))

; --- LLM Generated Split Constraints ---
(declare-const num_ba_segments_in_x Int)
(declare-const num_ba_segments_in_y Int)
(assert (= (str.num_splits x "ba") num_ba_segments_in_x))
(assert (= num_ba_segments_in_x 1))
(assert (= (str.num_splits y "ba") num_ba_segments_in_y))
(assert (= num_ba_segments_in_y 2))
(declare-const first_half_y String)
(declare-const second_half_y String)
(assert (= (str.split_at y "ba" 0) first_half_y))
(assert (= (str.split_at y "ba" 1) second_half_y))
(assert (= first_half_y "ba"))
(assert (= second_half_y "ba"))
; --- End LLM Generated Constraints ---

