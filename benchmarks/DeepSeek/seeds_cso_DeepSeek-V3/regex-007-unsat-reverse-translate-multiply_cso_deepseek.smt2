(declare-const x String)
(assert (= (str.len x) 16))
(assert (str.in_re x (re.* (str.to_re "yyffDD"))))
(assert (str.in_re x (re.* (str.to_re "yyDDvv''\\\\rr''"))))

; --- LLM Generated Split Constraints ---
; Multi-delimiter splitting with nested dependencies
(declare-const delim1 String)
(declare-const delim2 String)
(assert (= delim1 "yy"))
(assert (= delim2 "DD"))
; First split by "yy"
(assert (>= (str.num_splits x delim1) 3))
(declare-const part1 String)
(declare-const part2 String)
(declare-const part3 String)
(assert (= part1 (str.split_at x delim1 0)))
(assert (= part2 (str.split_at (str.split_rest x delim1 1) delim1 0)))
(assert (= part3 (str.split_rest (str.split_rest x delim1 1) delim1 1)))
; ; Validate split segments
(assert (str.contains part1 "ff"))
(assert (str.contains part2 "vv"))
(assert (str.contains part3 "\\\\rr''"))
; Cross-split constraints
(assert (>= (str.len part2) (str.len part1)))
(assert (str.prefixof "''" part3))
; Nested split by "DD" on part2
(assert (>= (str.num_splits part2 delim2) 2))
(declare-const subpart1 String)
(declare-const subpart2 String)
(assert (= subpart1 (str.split_at part2 delim2 0)))
(assert (= subpart2 (str.split_rest part2 delim2 1)))
; Advanced validation
(assert (not (= subpart1 subpart2)))
(assert (str.suffixof "vv" subpart2))
(assert (= (str.len subpart1) (str.indexof part3 "\\\\" 0)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
