(set-info :smt-lib-version 2.6)
(set-logic QF_SLIA)
(set-info :source |
Generated by: LLM-based constraint generator
Application: CSV/TSV field separation and validation
Target solver: CVC4, Z3, Z3str3, Z3-Noodler
|)
(set-info :license "https://creativecommons.org/licenses/by/4.0/")
(set-info :category "industrial")
(set-info :status unknown)

; This SMT-LIB2 file encodes CSV/TSV parsing and validation with various delimiters

; Declare input line and select a delimiter
(declare-const input_line String)
(declare-const delimiter String)

; Only allow specific delimiters: ',', '\t', ';', '|'
(assert
 (or (= delimiter ",")
 (= delimiter "\t")
 (= delimiter ";")
 (= delimiter "|")
)
)

; The input line must contain at least one occurrence of the delimiter
(assert (str.contains input_line delimiter))

; The line must be split into exactly 5 fields
(assert (= (str.num_splits input_line delimiter) 5))

; ; Extract all five fields
(declare-const f0 String)
(declare-const f1 String)
(declare-const f2 String)
(declare-const f3 String)
(declare-const f4 String)

(assert (= f0 (str.split_at input_line delimiter 0)))
(assert (= f1 (str.split_at input_line delimiter 1)))
(assert (= f2 (str.split_at input_line delimiter 2)))
(assert (= f3 (str.split_at input_line delimiter 3)))
(assert (= f4 (str.split_at input_line delimiter 4)))

; At least one field is empty (testing empty field handling)
(assert (or (= f0 "") (= f1 "") (= f2 "") (= f3 "") (= f4 "")))

; No field may contain the delimiter itself (naive CSV/TSV validation, no escape support)
(assert (not (str.contains f0 delimiter)))
(assert (not (str.contains f1 delimiter)))
(assert (not (str.contains f2 delimiter)))
(assert (not (str.contains f3 delimiter)))
(assert (not (str.contains f4 delimiter)))

; Field 3 (f2) must be a numeric string (unsatisfiable with alphabetic content)
(assert (forall ((c String))
 (=> (str.contains f2 c)
 (or (= c "0") (= c "1") (= c "2") (= c "3") (= c "4")
 (= c "5") (= c "6") (= c "7") (= c "8") (= c "9")))))

; Field 4 (f3) must not be empty (unsatisfiable together with earlier empty field assertion if f3 is the only empty)
(assert (> (str.len f3) 0))

(check-sat)
(exit)