(set-info :smt-lib-version 2.6)
(set-logic QF_SLIA)
(set-info :source |
Generated by: LLM-based constraint generator
Scenario: Email validation with string split operations
|)
(set-info :license "https://creativecommons.org/licenses/by/4.0/")
(set-info :category "industrial")
(set-info :status unknown)

; Declare the email string variable
(declare-const E String)

; Split on "@" to get user and domain (must be exactly two segments)
(assert (= (str.num_splits E "@") 2))

; Get username (before "@") and domain (after "@")
(declare-const U String)
(declare-const D String)
(assert (= U (str.split_at E "@" 0)))
(assert (= D (str.split_at E "@" 1)))

; Username must be at least 3 characters long
(assert (>= (str.len U) 3))

; Username must not contain "."
(assert (not (str.contains U ".")))

; Domain must have at least two segments when split by "."
(assert (>= (str.num_splits D ".") 2))

; The first domain segment (subdomain) must start with "mail"
(declare-const SUB String)
(assert (= SUB (str.split_at D "." 0)))
(assert (str.prefixof "mail" SUB))

; The last domain segment (TLD) must be exactly 3 characters
(declare-const TLD String)
(assert (= TLD (str.split_at D "." (- (str.num_splits D ".") 1))))
(assert (= (str.len TLD) 3))

; The email must not start or end with "@"
(assert (not (str.prefixof "@" E)))
(assert (not (str.suffixof "@" E)))

; The email must not have consecutive dots ".."
(assert (not (str.contains E "..")))

; ; Unsatisfiable constraint example: username must be both "abc" and "xyz"
(assert (or (= U "abc") (= U "xyz")))
(assert (not (= U "abc")))
(assert (not (= U "xyz")))

(check-sat)
(exit)