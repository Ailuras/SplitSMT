(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (str.to_re "tK*!vu|E,.a""'1@H#Z6k"))))
(assert (str.in_re y (re.* (re.+ (str.to_re "gC,t12")))))
(assert (= (str.to_int x) 11))
(assert (= (str.to_int y) 0))

; --- LLM Generated Split Constraints ---
; Multiple partitions: split x by 'H' and y by ','
(declare-const x_H_count Int)
(assert (= x_H_count (str.num_splits x "H")))
(assert (>= x_H_count 2))
(declare-const x_pre_H String)
(declare-const x_post_H String)
(assert (= x_pre_H (str.split_at x "H" 0)))
(assert (= x_post_H (str.split_rest x "H" 1)))
(declare-const y_comma_count Int)
(assert (= y_comma_count (str.num_splits y ",")))
(assert (>= y_comma_count 1))
(declare-const y_first String)
(declare-const y_rest String)
(assert (= y_first (str.split_at y "," 0)))
(assert (= y_rest (str.split_rest y "," 1)))
; Nested splits: split x_pre_H by 'Z'
(declare-const x_preH_Z_count Int)
(assert (= x_preH_Z_count (str.num_splits x_pre_H "Z")))
(declare-const x_preH_Z_0 String)
(declare-const x_preH_Z_1 String)
(assert (= x_preH_Z_0 (str.split_at x_pre_H "Z" 0)))
(assert (= x_preH_Z_1 (str.split_rest x_pre_H "Z" 1)))
; Nested splits: split y_first by 't'
(declare-const y_first_t_count Int)
(assert (= y_first_t_count (str.num_splits y_first "t")))
(declare-const y_first_t_0 String)
(assert (= y_first_t_0 (str.split_at y_first "t" 0)))
; Cross-dependencies: relate split segments of x and y
(assert (not (= x_preH_Z_0 y_first_t_0)))
(assert (str.contains x_post_H y_first_t_0))
; Advanced validation: require segment lengths and prefix/suffix relationships
(assert (> (str.len x_preH_Z_1) 0))
(assert (< (str.len y_first_t_0) (str.len x_preH_Z_1)))
(assert (str.prefixof x_preH_Z_0 x))
(assert (str.suffixof x_post_H x))
; --- End LLM Generated Constraints ---

