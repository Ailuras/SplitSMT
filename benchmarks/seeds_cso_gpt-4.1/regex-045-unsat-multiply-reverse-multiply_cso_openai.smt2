(declare-const x String)
(declare-const y String)
(declare-const m String)
(declare-const n String)
(assert (not (str.in_re x (re.* (str.to_re "ccccbbbbaaaa")))))
(assert (= x "ccccbbbbaaaa"))

; --- LLM Generated Split Constraints ---
; ; Split x by "b" and check partitioning
(declare-const xb_count Int)
(assert (= xb_count (str.num_splits x "b")))
(assert (>= xb_count 2))
(declare-const xb0 String)
(declare-const xb1 String)
(assert (= xb0 (str.split_at x "b" 0)))
(assert (= xb1 (str.split_rest x "b" 1)))
; Further split xb1 by "a", nest the operation
(declare-const xba0 String)
(declare-const xba1 String)
(assert (= xba0 (str.split_at xb1 "a" 0)))
(assert (= xba1 (str.split_rest xb1 "a" 1)))
; Split y by "c", require that one partition matches a segment from x's split
(declare-const yc0 String)
(declare-const yc1 String)
(assert (= yc0 (str.split_at y "c" 0)))
(assert (= yc1 (str.split_rest y "c" 1)))
(assert (= yc1 xb0)) ; cross-dependency
; Advanced validation: ensure concatenation of split segments yields original
(assert (= x (str.++ xb0 "b" xb1)))
(assert (= xb1 (str.++ xba0 "a" xba1)))
(assert (= y (str.++ yc0 "c" yc1)))
; Constraint on segment lengths and relationships
(assert (< (str.len xb0) (str.len xb1)))
(assert (> (str.len xba0) 0))
(assert (not (= xba1 "")))
; Cross-partition relationship: n must equal xba1
(assert (= n xba1))
; Enforce m starts with xb0 and ends with yc0
(assert (str.prefixof xb0 m))
(assert (str.suffixof yc0 m))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
