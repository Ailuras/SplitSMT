(assert (str.in_re x (re.* (str.to_re "ba"))))
(assert (str.in_re y (str.to_re "ba")))
(assert (= 2 (str.len x)))
(assert (= (str.len y) 4))

; --- LLM Generated Split Constraints ---
; Multiple partitions: split x and y by "a" and "b"
(declare-const x_split_a_0 String)
(declare-const x_split_a_1 String)
(assert (= x_split_a_0 (str.split_at x "a" 0)))
(assert (= x_split_a_1 (str.split_rest x "a" 1)))
(declare-const x_split_b_0 String)
(declare-const x_split_b_1 String)
(assert (= x_split_b_0 (str.split_at x "b" 0)))
(assert (= x_split_b_1 (str.split_rest x "b" 1)))
(declare-const y_split_a_0 String)
(declare-const y_split_a_1 String)
(declare-const y_split_a_2 String)
(assert (= y_split_a_0 (str.split_at y "a" 0)))
(assert (= y_split_a_1 (str.split_at y "a" 1)))
(assert (= y_split_a_2 (str.split_rest y "a" 2)))
; Nested splits: split one of y’s segments again on "b"
(declare-const y_seg1_b_0 String)
(declare-const y_seg1_b_1 String)
(assert (= y_seg1_b_0 (str.split_at y_split_a_1 "b" 0)))
(assert (= y_seg1_b_1 (str.split_rest y_split_a_1 "b" 1)))
; Cross-dependency: relate splits of x and y
(assert (not (= x_split_b_1 y_seg1_b_0)))
; Advanced validation: sum of segment lengths equals string lengths
(assert (= (+ (str.len y_split_a_0) (str.len y_split_a_1) (str.len y_split_a_2) 2) (str.len y)))
(assert (= (+ (str.len x_split_a_0) (str.len x_split_a_1)) (str.len x)))
; Advanced: require one segment of y equals x
(assert (or (= y_split_a_1 x) (= y_split_a_0 x)))
