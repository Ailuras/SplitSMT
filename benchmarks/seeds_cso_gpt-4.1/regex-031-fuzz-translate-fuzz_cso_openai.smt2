(set-info :smt-lib-version 2.6)
(set-logic QF_SLIA)
(set-info :source |
Generated by: Dmitry Blotsky1, Federico Mora, Murphy Berzish, Yunhui Zheng, Ifaz Kabir, Vijay Ganesh, Zhengyang Lu
Generated on: 2018-01-24
Generator: StringFuzz
Application: Evaluate string solvers
Target solver: Z3str3, CVC4, Z3str2, Norn
Publications: Blotsky, D., Mora, F., Berzish, M., Zheng, Y., Kabir, I., & Ganesh, V. (2018). Stringfuzz: A fuzzer for string solvers. In CAV 2018.
Description: transformed by StringFuzz, a modular string and regex fuzzer, from an industrial benchmark
|)
(set-info :license "https://creativecommons.org/licenses/by/4.0/")
(set-info :category "random")
(set-info :status unknown)

(declare-const x String)
(declare-const y String)
(declare-const m String)
(declare-const n String)
(assert (= (str.++ x y) (str.++ m n)))
(assert (str.in_re n (re.* (str.to_re ""))))
(assert (> (str.len x) (str.len m)))

; --- LLM Generated Split Constraints ---
; Split x using delimiter "|"
(declare-const x_parts_count Int)
(assert (= x_parts_count (str.num_splits x "|")))
(assert (>= x_parts_count 3))
; ; Extract the first and last segments of the split
(declare-const x_first String)
(declare-const x_middle String)
(declare-const x_last String)
(assert (= x_first (str.split_at x "|" 0)))
(assert (= x_middle (str.split_at x "|" 1)))
(assert (= x_last (str.split_at x "|" (- x_parts_count 1))))
; Split m using delimiter "-"
(declare-const m_parts_count Int)
(assert (= m_parts_count (str.num_splits m "-")))
(assert (>= m_parts_count 2))
(declare-const m_head String)
(declare-const m_tail String)
(assert (= m_head (str.split_at m "-" 0)))
(assert (= m_tail (str.split_rest m "-" 1)))
; Nested split: split m_head by ":"
(declare-const m_head_left String)
(declare-const m_head_right String)
(assert (= m_head_left (str.split_at m_head ":" 0)))
(assert (= m_head_right (str.split_rest m_head ":" 1)))
; Cross-dependency: x_first and m_head_left must be equal
(assert (= x_first m_head_left))
; Advanced validation: lengths and containment
(assert (not (= x_last m_tail)))
(assert (> (str.len x_middle) (str.len m_head_right)))
(assert (str.contains x_last m_head_right))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
