(declare-const x String)
(assert (= (str.len x) 16))
(assert (str.in_re x (re.* (str.to_re "yyffDD"))))
(assert (str.in_re x (re.* (str.to_re "yyDDvv''\\\\rr''"))))

; --- LLM Generated Split Constraints ---
; Split x by delimiter "DD" into at least 2 segments
(declare-const dd_seg_count Int)
(assert (= dd_seg_count (str.num_splits x "DD")))
(assert (>= dd_seg_count 2))
; First split by "DD"
(declare-const first_dd String)
(declare-const rest_dd String)
(assert (= first_dd (str.split_at x "DD" 0)))
(assert (= rest_dd (str.split_rest x "DD" 1)))
; Nested split: further split rest_dd by "yy"
(declare-const yy_seg_count Int)
(assert (= yy_seg_count (str.num_splits rest_dd "yy")))
(assert (>= yy_seg_count 2))
(declare-const sub_first_yy String)
(declare-const sub_rest_yy String)
(assert (= sub_first_yy (str.split_at rest_dd "yy" 0)))
(assert (= sub_rest_yy (str.split_rest rest_dd "yy" 1)))
; Cross-dependency: first_dd must be a suffix of sub_first_yy
(assert (str.suffixof first_dd sub_first_yy))
; Advanced validation: sub_rest_yy is not a substring of x
(assert (not (str.contains x sub_rest_yy)))
; Relationship: The lengths of first_dd and sub_first_yy must differ by exactly 2
(assert (= (abs (- (str.len first_dd) (str.len sub_first_yy))) 2))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
