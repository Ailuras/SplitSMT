(declare-const x String)
(declare-const y String)
(assert (str.in_re y (re.+ (re.* (str.to_re "aT' 'ge")))))
(assert (= (str.to_int y) 5))

; --- LLM Generated Split Constraints ---
(declare-const y_split0 String)
(declare-const y_split1 String)
(assert (= y_split0 (str.split_at y "a" 0))) ; first segment before first 'a'
(assert (= y_split1 (str.split_at y "a" 1))) ; segment after first 'a'
(assert (= (str.num_splits y "a") 2)) ; splitting y by 'a' gives 2 segments
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
