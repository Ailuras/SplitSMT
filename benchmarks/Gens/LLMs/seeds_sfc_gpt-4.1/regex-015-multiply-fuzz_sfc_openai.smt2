(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (str.to_re "tK*!vu|E,.a""'1@H#Z6k"))))
(assert (str.in_re y (re.* (re.+ (str.to_re "gC,t12")))))
(assert (= (str.to_int x) 11))
(assert (= (str.to_int y) 0))

; --- LLM Generated Split Constraints ---
(declare-const x_seg0 String)
(declare-const x_seg1 String)
(assert (= x_seg0 (str.split_at x "!" 0)))
(assert (= x_seg1 (str.split_at x "!" 1)))
(assert (>= (str.len x_seg0) 0))
(assert (>= (str.len x_seg1) 0))
(assert (<= (str.num_splits x "!") 2))
(declare-const y_first String)
(assert (= y_first (str.split_at y "," 0)))
(assert (<= (str.num_splits y ",") 3))
(declare-const y_rest String)
(assert (= y_rest (str.split_rest y "," 1)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
