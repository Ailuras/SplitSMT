(declare-const dot_parts_count Int)
(declare-const dash_parts_count Int)
(assert (= dot_parts_count (str.num_splits s ".")))
(assert (= dash_parts_count (str.num_splits s "-")))
(assert (>= dot_parts_count 2))
(assert (>= dash_parts_count 2))
; Primary split by "." delimiter
(declare-const left_dot String)
(declare-const right_dot String)
(assert (= left_dot (str.split_at s "." 0)))
(assert (= right_dot (str.split_rest s "." 1)))
; Nested split on left part by "-"
(declare-const left_dash1 String)
(declare-const left_dash2 String)
