(assert (= left_dash1 (str.split_at left_dot "-" 0)))
(assert (= left_dash2 (str.split_rest left_dot "-" 1)))
; Nested split on right part by "-"
(declare-const right_dash1 String)
(declare-const right_dash2 String)
(assert (>= (str.num_splits right_dot "-") 2))
(assert (= right_dash1 (str.split_at right_dot "-" 0)))
(assert (= right_dash2 (str.split_rest right_dot "-" 1)))
; Cross-partition constraints
(assert (not (= left_dash1 right_dash1)))
(assert (> (str.len left_dash2) (str.len right_dash1)))
; Complex validation constraints
(assert (< (str.len left_dot) (2 (str.len right_dot))))
(assert (> (+ (str.len left_dash1) (str.len right_dash1)) 5))
; Multi-level split dependencies
(declare-const nested_split String)
(assert (= nested_split (str.split_at left_dash2 "-" 0)))
(assert (not (= nested_split right_dash2)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
