(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (str.to_re "t'GP_'\\x0c'n'p'\\n'8*pi5"))))
(assert (str.in_re y (re.* (re.+ (str.to_re "AS\\\\JV'\\t'Iwmdf12")))))
(assert (= (str.len x) 5))
(assert (= (str.len y) 9))

; --- LLM Generated Split Constraints ---
; Multiple partitions: split y by "I" and by "f"
(declare-const y_I_count Int)
(declare-const y_f_count Int)
(assert (= y_I_count (str.num_splits y "I")))
(assert (= y_f_count (str.num_splits y "f")))
(assert (>= y_I_count 2))
(assert (>= y_f_count 2))
; Split y at first "I", then split the remainder at first "f"
(declare-const y_I0 String)
(declare-const y_I1rest String)
(assert (= y_I0 (str.split_at y "I" 0)))
(assert (= y_I1rest (str.split_rest y "I" 1)))
(declare-const y_I1_f0 String)
(declare-const y_I1_f1rest String)
(assert (= y_I1_f0 (str.split_at y_I1rest "f" 0)))
(assert (= y_I1_f1rest (str.split_rest y_I1rest "f" 1)))
; Nested split: split y_I0 by "d"
(declare-const y_I0_d0 String)
(declare-const y_I0_d1rest String)
(assert (= y_I0_d0 (str.split_at y_I0 "d" 0)))
(assert (= y_I0_d1rest (str.split_rest y_I0 "d" 1)))
; Cross-dependency: ensure y_I0_d0 is a prefix of x
(assert (str.prefixof y_I0_d0 x))
; Advanced validation: the segment between "I" and "f" (y_I1_f0) must not appear in x
(assert (not (str.contains x y_I1_f0)))
; Segment length relationships
(assert (> (str.len y_I0) 1))
(assert (> (str.len y_I1_f0) 2))
(assert (= (+ (str.len y_I0) (str.len y_I1_f0)) 5)) ; sum of two segments equals 5
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
