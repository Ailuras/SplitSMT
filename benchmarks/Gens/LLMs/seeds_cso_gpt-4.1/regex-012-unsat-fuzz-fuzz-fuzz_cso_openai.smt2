|)
(set-info :license "https://creativecommons.org/licenses/by/4.0/")
(set-info :category "random")
(set-info :status unknown)

(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (re.++ (str.to_re "C-'\x0b'xX'\r'Lk0p<'\r'O:N'\t'Kw'\t'#{7^0' 'Pdr\\&2cTH") (str.to_re "w'\x0b'&OoLr")))))
(assert (= 8 (str.to_int x)))

; --- LLM Generated Split Constraints ---
; Split x by ":" and ensure at least 2 segments
(declare-const x_colon_count Int)
(assert (= x_colon_count (str.num_splits x ":")))
(assert (>= x_colon_count 2))
; Obtain the first and rest segments after split by ":"
(declare-const x_first_colon String)
(declare-const x_rest_colon String)
(assert (= x_first_colon (str.split_at x ":" 0)))
(assert (= x_rest_colon (str.split_rest x ":" 1)))
; Further split the rest by "#"
(declare-const x_hash_count Int)
(assert (= x_hash_count (str.num_splits x_rest_colon "#")))
(assert (>= x_hash_count 2))
(declare-const x_hash_first String)
(declare-const x_hash_second String)
(assert (= x_hash_first (str.split_at x_rest_colon "#" 0)))
(assert (= x_hash_second (str.split_at x_rest_colon "#" 1)))
; Now, split y by "w" and require at least 2 segments
(declare-const y_w_count Int)
(assert (= y_w_count (str.num_splits y "w")))
(assert (>= y_w_count 2))
(declare-const y_first_w String)
(assert (= y_first_w (str.split_at y "w" 0)))
; Cross-dependency: the first segment after ":" in x must equal the first segment before "w" in y
(assert (= x_first_colon y_first_w))
; Advanced validation: lengths and non-equality
(assert (> (str.len x_hash_first) 5))
(assert (< (str.len x_hash_second) 10))
(assert (not (= x_hash_first x_hash_second)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
