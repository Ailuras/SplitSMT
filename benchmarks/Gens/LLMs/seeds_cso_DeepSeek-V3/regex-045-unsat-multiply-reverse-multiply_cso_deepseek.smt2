; --- LLM Generated Split Constraints ---
; Multi-delimiter hierarchical splitting with cross-validation
(declare-const input String)
(assert (str.contains input "|"))
(assert (str.contains input ":"))
(assert (> (str.len input) 25))
; First level split by "|" into header and payload
(declare-const header String)
(declare-const payload String)
(assert (= header (str.substr input 0 (str.indexof input "|" 0))))
(assert (= payload (str.substr input (+ (str.indexof input "|" 0) 1) (- (str.len input) (str.indexof input "|" 0) 1))))
; Split header into version and timestamp
(assert (>= (str.num_splits header ":") 2))
(declare-const version String)
(declare-const timestamp String)
(assert (= version (str.substr header 0 (str.indexof header ":" 0))))
(assert (= timestamp (str.substr header (+ (str.indexof header ":" 0) 1) (- (str.len header) (str.indexof header ":" 0) 1))))
; Nested split of payload by ":" into segments
(assert (>= (str.num_splits payload ":") 3))
(declare-const segment1 String)
(declare-const segment2 String)
(declare-const segment3 String)
(assert (= segment1 (str.substr payload 0 (str.indexof payload ":" 0))))
(assert (= segment2 (str.substr payload (+ (str.indexof payload ":" 0) 1) (str.indexof payload ":" (+ (str.indexof payload ":" 0) 1)))))
(assert (= segment3 (str.substr payload (+ (str.indexof payload ":" (+ (str.indexof payload ":" 0) 1)) 1) (- (str.len payload) (str.indexof payload ":" (+ (str.indexof payload ":" 0) 1)) 1))))
; Cross-validation constraints
(assert (str.prefixof "v" version))
(assert (str.is_digit timestamp))
(assert (not (str.contains segment1 "|")))
(assert (str.suffixof segment2 segment3))
(assert (< (str.len segment1) (str.len segment2)))
(assert (> (str.len segment3) (+ (str.len version) (str.len timestamp))))
; Relationship between header and payload
(assert (distinct (str.len header) (str.len segment1)))
(assert (= (str.at version 1) (str.at segment1 0)))
