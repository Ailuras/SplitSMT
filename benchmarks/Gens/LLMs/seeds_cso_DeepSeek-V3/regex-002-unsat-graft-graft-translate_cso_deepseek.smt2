(declare-const x String)
(declare-const y String)
(assert (= x "[[[[[[[[["))
(assert (str.in_re x (str.to_re ")AU")))

; --- LLM Generated Split Constraints ---
; Multi-delimiter splitting with nested dependencies
(declare-const input String)
(assert (str.contains input "|"))
(assert (str.contains input ";"))
(assert (str.contains input ":"))
(assert (> (str.len input) 30))
; First split by "|" into exactly 3 parts
(assert (= (str.num_splits input "|") 3))
(declare-const part1 String)
(declare-const part2 String)
(declare-const part3 String)
(assert (= part1 (str.split_at input "|" 0)))
(assert (= part2 (str.split_at input "|" 1)))
(assert (= part3 (str.split_rest input "|" 2)))
; Split part2 by ";" into exactly 2 segments
(assert (= (str.num_splits part2 ";") 2))
(declare-const segA String)
(declare-const segB String)
(assert (= segA (str.split_at part2 ";" 0)))
(assert (= segB (str.split_rest part2 ";" 1)))
; Split part3 by ":" with validation
(assert (>= (str.num_splits part3 ":") 1))
(declare-const left String)
(declare-const right String)
(assert (= left (str.split_at part3 ":" 0)))
(assert (= right (str.split_rest part3 ":" 1)))
; Cross-dependency constraints
(assert (str.prefixof segA left))
(assert (str.suffixof segB right))
(assert (not (= part1 segA)))
(assert (> (str.len part1) (str.len segB)))
; Length relationships
(assert (= (str.len input) (+ (str.len part1) (str.len part2) (str.len part3) 2))) ; +2 for two "|" delimiters
(assert (< (str.len segA) (str.len segB)))
; Final validation
(assert (str.contains left segA))
(assert (str.contains right segB))
(assert (not (str.contains part1 ";")))
(assert (not (str.contains part1 ":")))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
