(assert (= x_split_1 (str.split_at x " " 1)))
(assert (= m_split_0 (str.split_at m " " 0)))
(assert (= m_split_1 (str.split_at m " " 1)))
(assert (>= (str.num_splits x " ") 1))
(assert (>= (str.num_splits m " ") 1))
(assert (>= (str.len x_split_0) 0))
(assert (>= (str.len m_split_0) 0))
