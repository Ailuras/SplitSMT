(declare-const x String)
(declare-const y String)
(assert (str.in_re y (re.+ (re.* (str.to_re "aT' 'ge")))))
(assert (= (str.to_int y) 5))

; --- LLM Generated Split Constraints ---
(declare-const y_first String)
(declare-const y_second String)
; Split y at first space character
(assert (= y_first (str.split_at y " " 0)))
(assert (= y_second (str.split_at y " " 1)))
; Verify split produces non-empty segments
(assert (> (str.len y_first) 0))
(assert (> (str.len y_second) 0))
; ; Check number of splits when using 'T' as delimiter
(assert (>= (str.num_splits y "T") 1))
; Get remaining segments after first split
(declare-const y_rest String)
(assert (= y_rest (str.split_rest y "a" 1)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
