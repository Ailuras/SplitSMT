(declare-const part0 String)
(declare-const part1 String)
(declare-const part2 String)
(assert (= part0 (str.split_at s "." 0)))
(assert (= part1 (str.split_at s "." 1)))
(assert (= part2 (str.split_at s "." 2)))
; Basic validation of split parts
(assert (> (str.len part0) 0))
(assert (> (str.len part1) 0))
(assert (> (str.len part2) 0))
; Count number of splits
(assert (= (str.num_splits s ".") 3))
; Get remaining segments after first split
(declare-const rest_parts String)
(assert (= rest_parts (str.split_rest s "." 1)))
(assert (str.contains rest_parts "."))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
