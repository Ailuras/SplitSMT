(set-info :smt-lib-version 2.6)
(set-logic QF_SLIA)
(set-info :source |
Generated by: LLM-based constraint generator
Scenario: Email validation with split and structure constraints
Target: SMT solvers supporting string split extensions
|)
(set-info :license "https://creativecommons.org/licenses/by/4.0/")
(set-info :category "industrial")
(set-info :status unknown)

; Declare the email string variable
(declare-const email_addr String)

; Ensure there is exactly one '@' in the email
(assert (= (str.num_splits email_addr "@") 2))

; ; Extract the user (before '@') and host (after '@')
(declare-const user_part String)
(declare-const host_part String)
(assert (= user_part (str.split_at email_addr "@" 0)))
(assert (= host_part (str.split_at email_addr "@" 1)))

; User part must not start or end with a dot
(assert (not (= (str.at user_part 0) ".")))
(assert (not (= (str.at user_part (- (str.len user_part) 1)) ".")))

; User part must be at least 3 characters long
(assert (>= (str.len user_part) 3))

; Host part must split into at least 3 segments with "."
(assert (>= (str.num_splits host_part ".") 3))

; ; Extract subdomain, domain, and tld
(declare-const subdomain String)
(declare-const domain String)
(declare-const tld String)
(assert (= subdomain (str.split_at host_part "." 0)))
(assert (= domain (str.split_at host_part "." 1)))
(assert (= tld (str.split_at host_part "." 2)))

; Subdomain and domain must be non-empty
(assert (> (str.len subdomain) 0))
(assert (> (str.len domain) 0))

; TLD must be exactly 3 characters
(assert (= (str.len tld) 3))

; Host part must not start or end with a dot
(assert (not (= (str.at host_part 0) ".")))
(assert (not (= (str.at host_part (- (str.len host_part) 1)) ".")))

; ; Unsatisfiable constraint: user part must be "admin", but must be at least 6 chars
(assert (= user_part "admin"))
(assert (>= (str.len user_part) 6))

(check-sat)
(exit)