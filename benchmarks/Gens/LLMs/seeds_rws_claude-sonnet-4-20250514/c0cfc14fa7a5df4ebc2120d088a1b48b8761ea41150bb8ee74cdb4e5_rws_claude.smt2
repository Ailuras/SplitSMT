(set-info :smt-lib-version 2.6)
(set-logic QF_SLIA)
(set-info :source |
Generated by: LLM-based constraint generator
Application: Multi-delimiter CSV/TSV validation scenario
Target solver: CVC4, Z3, Z3str3, Z3-Noodler
|)
(set-info :license "https://creativecommons.org/licenses/by/4.0/")
(set-info :category "industrial")
(set-info :status unknown)

; Multi-format data record processing
(declare-const data_record String)
(declare-const delimiter_used String)

; TSV processing with tab delimiter
(declare-const tsv_field_count Int)
(assert (= tsv_field_count (str.num_splits data_record "\t")))

; Semicolon-separated values processing
(declare-const ssv_field_count Int)
(assert (= ssv_field_count (str.num_splits data_record ";")))

; Pipe-separated values processing
(declare-const psv_field_count Int)
(assert (= psv_field_count (str.num_splits data_record "|")))

; Determine which delimiter produces exactly 4 fields
(assert (or 
 (and (= delimiter_used "\t") (= tsv_field_count 4))
 (and (= delimiter_used ";") (= ssv_field_count 4))
 (and (= delimiter_used "|") (= psv_field_count 4))))

; ; Extract fields based on determined delimiter
(declare-const name_field String)
(declare-const email_field String)
(declare-const age_field String)
(declare-const status_field String)

(assert (= name_field (str.split_at data_record delimiter_used 0)))
(assert (= email_field (str.split_at data_record delimiter_used 1)))
(assert (= age_field (str.split_at data_record delimiter_used 2)))
(assert (= status_field (str.split_at data_record delimiter_used 3)))

; Field validation constraints
; Name field cannot be empty
(assert (> (str.len name_field) 0))

; Email must contain @ symbol
(assert (str.contains email_field "@"))

; ; Age field must be numeric (simplified check - no letters)
(assert (not (str.contains age_field "a")))
(assert (not (str.contains age_field "b")))
(assert (not (str.contains age_field "c")))

; Status field must be one of predefined values
(assert (or 
 (= status_field "active")
 (= status_field "inactive")
 (= status_field "pending")
 (= status_field "")))

; Escape sequence handling - no unescaped quotes in fields
(assert (not (str.contains name_field "")))
(assert (not (str.contains email_field "")))

; Empty field detection - at most one empty field allowed
(declare-const empty_count Int)
(assert (= empty_count 
 (+ (ite (= (str.len name_field) 0) 1 0)
 (ite (= (str.len email_field) 0) 1 0)
 (ite (= (str.len age_field) 0) 1 0)
 (ite (= (str.len status_field) 0) 1 0))))
(assert (<= empty_count 1))

; Data record length constraints
(assert (and (>= (str.len data_record) 10) (<= (str.len data_record) 200)))

(check-sat)
(exit)