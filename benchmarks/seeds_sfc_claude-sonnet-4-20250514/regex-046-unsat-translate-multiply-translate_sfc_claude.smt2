(declare-const x String)
(assert (str.in_re x (re.+ (str.to_re "YY"))))
(assert (> 2 (str.len x)))

; --- LLM Generated Split Constraints ---
(declare-const x_split_0 String)
(declare-const x_split_1 String)
(assert (= x_split_0 (str.split_at x "Y" 0)))
(assert (= x_split_1 (str.split_at x "Y" 1)))
(assert (>= (str.num_splits x "Y") 1))
(assert (<= (str.num_splits x "Y") 2))
(assert (= (str.len x_split_0) 0))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
