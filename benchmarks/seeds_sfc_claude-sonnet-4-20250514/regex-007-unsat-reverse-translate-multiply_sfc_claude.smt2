(declare-const x String)
(assert (= (str.len x) 16))
(assert (str.in_re x (re.* (str.to_re "yyffDD"))))
(assert (str.in_re x (re.* (str.to_re "yyDDvv''\\\\rr''"))))

; --- LLM Generated Split Constraints ---
(declare-const x_seg0 String)
(declare-const x_seg1 String)
(declare-const x_seg2 String)
(assert (= x_seg0 (str.split_at x "y" 0)))
(assert (= x_seg1 (str.split_at x "y" 1)))
(assert (= x_seg2 (str.split_at x "y" 2)))
(assert (<= (str.num_splits x "y") 3))
(declare-const x_dd_seg0 String)
(declare-const x_dd_seg1 String)
(assert (= x_dd_seg0 (str.split_at x "DD" 0)))
(assert (= x_dd_seg1 (str.split_at x "DD" 1)))
(assert (>= (str.num_splits x "DD") 1))
(declare-const x_rest String)
(assert (= x_rest (str.split_rest x "ff" 1)))
(assert (>= (str.len x_rest) 0))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
