(declare-const x String)
(assert (str.in_re x (re.+ (str.to_re "YY"))))
(assert (> 2 (str.len x)))

; --- LLM Generated Split Constraints ---
; ; Split x by "Y" to extract all segments between "Y"s (should be empty strings for "YY" patterns)
(declare-const n_splits Int)
(assert (= n_splits (str.num_splits x "Y")))
; There must be at least 2 splits for any non-empty x in (YY)+
(assert (>= n_splits 2))
; Nested split: split x by "YY" to get sequence of empty strings (since x is "YY" repeated)
(declare-const n_yy_splits Int)
(assert (= n_yy_splits (str.num_splits x "YY")))
; Advanced validation: n_yy_splits = (str.len x) div 2 + 1
(assert (= n_yy_splits (+ (div (str.len x) 2) 1)))
; Cross-dependency: number of "Y" splits is twice number of "YY" splits minus 1
(assert (= n_splits (- n_yy_splits 1)))
; ; Extract first segment after splitting by "Y" (should be empty)
(declare-const first_y_split String)
(assert (= first_y_split (str.split_at x "Y" 0)))
(assert (= first_y_split ""))
; ; Extract first segment after splitting by "YY" (should be empty)
(declare-const first_yy_split String)
(assert (= first_yy_split (str.split_at x "YY" 0)))
(assert (= first_yy_split ""))
; The last segment after splitting by "YY" should also be empty
(declare-const last_yy_split String)
(assert (= last_yy_split (str.split_at x "YY" (- n_yy_splits 1))))
(assert (= last_yy_split ""))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
