(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (re.++ (re.* (str.to_re "C")) (str.to_re """")))))
(assert (= (str.to_int x) 6))
(assert (not (= x "a&t")))
(assert (not (= x "V")))
(assert (not (= x "b")))

; --- LLM Generated Split Constraints ---
; Split x by "C", require at least three segments (multiple partitions)
(declare-const x_C_count Int)
(assert (= x_C_count (str.num_splits x "C")))
(assert (>= x_C_count 3))
; Get first and second segments after splitting x by "C"
(declare-const x_first String)
(declare-const x_second String)
(assert (= x_first (str.split_at x "C" 0)))
(assert (= x_second (str.split_at x "C" 1)))
; Nested split: split x_second by '"' (quote character)
(declare-const x_second_quote_count Int)
(assert (= x_second_quote_count (str.num_splits x_second """")))
(assert (>= x_second_quote_count 2))
(declare-const x_second_first String)
(declare-const x_second_rest String)
(assert (= x_second_first (str.split_at x_second """" 0)))
(assert (= x_second_rest (str.split_rest x_second """" 1)))
; Cross-dependency: relate x_first and x_second_first
(assert (not (= x_first x_second_first)))
(assert (str.contains x_second_first x_first))
; Advanced validation: enforce segment lengths and relationship with y
(assert (> (str.len x_second_first) 0))
(assert (< (str.len x_second_first) (str.len x_second)))
(assert (str.contains y x_second_rest))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
