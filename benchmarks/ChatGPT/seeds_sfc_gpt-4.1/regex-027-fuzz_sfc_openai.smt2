(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (re.++ (re.* (str.to_re "C")) (str.to_re """")))))
(assert (= (str.to_int x) 6))
(assert (not (= x "a&t")))
(assert (not (= x "V")))
(assert (not (= x "b")))

; --- LLM Generated Split Constraints ---
(declare-const x_seg0 String)
(declare-const x_seg1 String)
(assert (= x_seg0 (str.split_at x "C" 0))) ; first segment before first 'C'
(assert (= x_seg1 (str.split_at x "C" 1))) ; segment after first 'C'
(assert (>= (str.num_splits x "C") 1)) ; there is at least one segment
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
