(declare-const x String)
(declare-const y String)
(assert (= x "[[[[[[[[["))
(assert (str.in_re x (str.to_re ")AU")))

; --- LLM Generated Split Constraints ---
; Split x at "[" and access the first and second segments
(declare-const x_seg0 String)
(declare-const x_seg1 String)
(assert (= x_seg0 (str.split_at x "[" 0)))
(assert (= x_seg1 (str.split_at x "[" 1)))
; Number of splits in x when splitting at "["
(declare-const x_num_splits Int)
(assert (= x_num_splits (str.num_splits x "[")))
(assert (>= x_num_splits 1))
; Access the rest of the segments from index 1
(declare-const x_rest String)
(assert (= x_rest (str.split_rest x "[" 1)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
