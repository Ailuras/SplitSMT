(declare-const x String)
(declare-const y String)
(declare-const m String)
(declare-const n String)
(assert (= (str.++ x y) (str.++ m n)))
(assert (str.in_re n (re.* (str.to_re ""))))
(assert (> (str.len x) (str.len m)))

; --- LLM Generated Split Constraints ---
(declare-const x_seg0 String)
(declare-const x_seg1 String)
(assert (= x_seg0 (str.split_at x "a" 0)))
(assert (= x_seg1 (str.split_at x "a" 1)))
(assert (= (str.num_splits x "a") 2))
(declare-const m_seg0 String)
(declare-const m_seg1 String)
(assert (= m_seg0 (str.split_at m "b" 0)))
(assert (= m_seg1 (str.split_at m "b" 1)))
(assert (= (str.num_splits m "b") 2))
(declare-const y_rest String)
(assert (= y_rest (str.split_rest y "c" 1)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
