(declare-const x String)
(declare-const y String)
(assert (= x "[[[[[[[[["))
(assert (str.in_re x (str.to_re ")AU")))

; --- LLM Generated Split Constraints ---
; Basic split operations on string x with "[" as delimiter
(assert (= (str.num_splits x "[") 10)) ; 9 "[" characters + empty string after last "["
(assert (= (str.len (str.split_at x "[" 0)) 0)) ; First segment should be empty
(assert (= (str.len (str.split_at x "[" 1)) 0)) ; Second segment should be empty
(assert (= (str.len (str.split_rest x "[" 5)) 4)) ; Should have 4 segments remaining from index 5
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
