(declare-const x String)
(declare-const y String)
(declare-const m String)
(declare-const n String)
(assert (= (str.++ x y) (str.++ m n)))
(assert (str.in_re n (re.* (str.to_re ""))))
(assert (> (str.len x) (str.len m)))

; --- LLM Generated Split Constraints ---
; Basic split operations on string x with space as delimiter
(assert (= (str.num_splits x " ") 2)) ; x should split into exactly 2 parts
(assert (> (str.len (str.split_at x " " 0)) 0)) ; first segment not empty
(assert (> (str.len (str.split_at x " " 1)) 0)) ; second segment not empty
; Split validation on string y with comma delimiter
(assert (<= (str.num_splits y ",") 3)) ; y has at most 3 comma-separated parts
; Split remaining segments operation
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
