(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (re.++ (str.to_re "C-'\x0b'xX'\r'Lk0p<'\r'O:N'\t'Kw'\t'#{7^0' 'Pdr\\&2cTH") (str.to_re "w'\x0b'&OoLr")))))
(assert (= 8 (str.to_int x)))

; --- LLM Generated Split Constraints ---
; Split x on common characters from the regex pattern
(declare-const x_part0 String)
(declare-const x_part1 String)
(assert (= x_part0 (str.split_at x "'" 0))) ; Split on single quote
(assert (= x_part1 (str.split_at x "'" 1)))
(assert (> (str.len x_part0) 0)) ; Ensure non-empty parts
(assert (> (str.len x_part1) 0))
; Split on colon character
(declare-const x_colon_split String)
(assert (= x_colon_split (str.split_at x ":" 0)))
; Count splits on newline/tab characters
(assert (>= (str.num_splits x "\t") 1))
(assert (>= (str.num_splits x "\r") 1))
; ; Validate split operations don't break length constraint
(assert (<= (str.len (str.split_rest x "C" 0)) 8))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
