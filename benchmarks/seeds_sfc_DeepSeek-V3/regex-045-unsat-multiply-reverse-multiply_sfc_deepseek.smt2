(declare-const x String)
(declare-const y String)
(declare-const m String)
(declare-const n String)
(assert (not (str.in_re x (re.* (str.to_re "ccccbbbbaaaa")))))
(assert (= x "ccccbbbbaaaa"))

; --- LLM Generated Split Constraints ---
; Split x on "b" delimiter and verify basic properties
(assert (= (str.num_splits x "b") 5)) ; "cccc" + 4 "b" segments + "aaaa"
(assert (= (str.split_at x "b" 0) "cccc")) ; First segment before first "b"
(assert (= (str.split_at x "b" 1) "")) ; Empty segment between first two "b"s
(assert (= (str.split_rest x "b" 2) "bbaaaa")) ; Remaining string from index 2
; ; Validate split segments have expected lengths
(assert (>= (str.len (str.split_at x "a" 0)) 8)) ; First segment before "a"
(assert (= (str.num_splits x "c") 5)) ; 4 "c"s create 5 segments
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
