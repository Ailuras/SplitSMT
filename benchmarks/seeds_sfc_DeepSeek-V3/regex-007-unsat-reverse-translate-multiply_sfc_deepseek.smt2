(declare-const x String)
(assert (= (str.len x) 16))
(assert (str.in_re x (re.* (str.to_re "yyffDD"))))
(assert (str.in_re x (re.* (str.to_re "yyDDvv''\\\\rr''"))))

; --- LLM Generated Split Constraints ---
; ; Split x on "yy" delimiter and check basic properties
(assert (= (str.num_splits x "yy") 3)) ; Expect 3 segments when splitting "yyffDDyyDDvv''\\rr''"
(assert (> (str.len (str.split_at x "yy" 0)) 0)) ; First segment should exist
(assert (> (str.len (str.split_at x "yy" 1)) 0)) ; Second segment should exist
(assert (= (str.len (str.split_rest x "yy" 2)) 8)) ; Remaining string after 2 splits
; Additional split on single character delimiter
(assert (<= (str.num_splits x "f") 2)) ; "f" appears at most
(assert (str.contains (str.split_at x "D" 1) "D")) ; Second segment should have D
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
