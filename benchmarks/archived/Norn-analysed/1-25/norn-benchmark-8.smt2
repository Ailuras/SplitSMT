(declare-fun x () String)

(assert (str.in_re
    (str.++ ; x + z = ([ac] + [zac])* + [ac""]
        x
        "z"
    )
    (re.* (re.++
        (re.union
            (str.to_re "a")
            (str.to_re "c")
