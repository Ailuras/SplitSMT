(declare-fun x8 () String)
(declare-fun x9 () String)
(declare-fun len_tmp0 () Int)
(declare-fun len_tmp1 () Int)
(assert
    (str.in_re
        x8
        (re.* (str.to_re "a"))
    )
)
(assert
    (str.in_re
        x9
        (re.++
            (re.* (str.to_re "a"))
            (str.to_re "b")
        )
    )
)
(assert (not
    (str.in_re
        (str.++
            "b"
            x8
            "z"
            "b"
            x9
        )
        (re.++
            (re.* (re.union
                (str.to_re "a")
                (re.++
                    (str.to_re "b")
                    (re.* (re.union
                        (str.to_re "z")
                        (str.to_re "a")
                    ))
                    (str.to_re "b")
                )
            ))
            (str.to_re "b")
            (re.* (re.union
                (str.to_re "z")
                (str.to_re "a")
            ))
        )
    )
))
(assert
    (>= len_tmp0 0)
)
(assert
    (>= len_tmp1 0)
)
(assert
    (= (str.len x9) (+ 1 (* 1 len_tmp0)))
)
(assert
    (= (str.len x8) (+ 1 (* 1 len_tmp1)))
)
(check-sat)
(exit)
