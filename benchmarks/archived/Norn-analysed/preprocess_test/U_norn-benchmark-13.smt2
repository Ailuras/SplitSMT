(declare-fun x9 () String)
(declare-fun x10 () String)
(declare-fun len_tmp0 () Int)
(declare-fun len_tmp1 () Int)
(assert
    (str.in_re
        x9
        (re.* (re.union
            (str.to_re "a")
            (str.to_re "c")
        ))
    )
)
(assert
    (str.in_re
        x9
        (re.* (re.range "a" "c"))
    )
)
(assert
    (str.in_re
        x10
        (re.* (re.range "a" "c"))
    )
)
(assert
    (or
        (not
            (str.in_re
                (str.++
                    x9
                    "a"
                )
                (re.++
                    (re.union
                        (str.to_re "a")
                        (str.to_re "c")
                    )
                    (re.* (re.union
                        (str.to_re "a")
                        (str.to_re "c")
                    ))
                )
            )
        )
        (not
            (str.in_re
                x10
                (re.union
                    (re.++
                        (str.to_re "a")
                        (re.* (re.union
                            (str.to_re "a")
                            (str.to_re "c")
                        ))
                    )
                    (re.++
                        (str.to_re "c")
                        (re.* (re.union
                            (str.to_re "a")
                            (str.to_re "c")
                        ))
                    )
                )
            )
        )
    )
)
(assert
    (>= len_tmp0 0)
)
(assert
    (>= len_tmp1 0)
)
(assert
    (= (str.len x10) (+ 1 (* 1 len_tmp0)))
)
(assert
    (= (str.len x9) (+ 1 (* 1 len_tmp1)))
)
(check-sat)
(exit)
