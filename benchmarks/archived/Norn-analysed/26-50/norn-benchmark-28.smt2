(declare-fun x_4 () String)
(declare-fun x_5 () String)
(assert
    (str.in_re; x4 + z + x5 in [b|za|aa]*
        (str.++
            x_4
            "z"
            x_5
        )
        (re.* (re.union
            (str.to_re "b")
            (re.++
                (str.to_re "z")
                (str.to_re "a")
            )
        ))
    )
)
(assert
    (str.in_re
        x_5
        (re.* (str.to_re "b"))
    )
)
(assert
    (str.in_re
        x_4
        (re.* (str.to_re "a"))
    )
)
(check-sat)
