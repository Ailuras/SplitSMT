(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.* (str.to_re "ba"))))
(assert (str.in_re y (str.to_re "ba")))
(assert (= 2 (str.len x)))
(assert (= (str.len y) 4))

; --- LLM Generated Split Constraints ---
; Multi-delimiter splitting with proper string constant delimiters
(declare-const input String)
(assert (str.contains input "|"))
(assert (str.contains input ":"))
(assert (> (str.len input) 25))
; First split by "|" into exactly 3 parts
(assert (= (str.num_splits input "|") 3))
(declare-const part1 String)
(declare-const part2 String)
(declare-const part3 String)
(assert (= part1 (str.split_at input "|" 0)))
(assert (= part2 (str.split_at input "|" 1)))
(assert (= part3 (str.split_rest input "|" 2)))
; Split part2 by ":" into exactly 2 parts
(assert (= (str.num_splits part2 ":") 2))
(declare-const subpart1 String)
(declare-const subpart2 String)
(assert (= subpart1 (str.split_at part2 ":" 0)))
(assert (= subpart2 (str.split_rest part2 ":" 1)))
; Cross-partition constraints
(assert (str.prefixof subpart1 part1))
(assert (str.contains part3 subpart2))
; Length relationships
(assert (> (str.len part1) (str.len subpart1)))
(assert (< (str.len subpart2) (str.len part3)))
; Final validation combining splits
(assert (str.contains (str.++ part1 part3) "data"))
(assert (not (= subpart1 subpart2)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
