(declare-const x String)
(declare-const y String)
(assert (str.in_re y (re.+ (re.* (str.to_re "aT' 'ge")))))
(assert (= (str.to_int y) 5))

; --- LLM Generated Split Constraints ---
; Multi-delimiter hierarchical splitting with cross-validation
(declare-const input String)
(assert (str.contains input "|"))
(assert (str.contains input ";"))
(assert (str.contains input ":"))
; First-level split by pipe
(declare-const pipe_parts Int)
(assert (= pipe_parts (str.num_splits input "|")))
(assert (>= pipe_parts 3))
(declare-const header String)
(declare-const body String)
(declare-const footer String)
(assert (= header (str.split_at input "|" 0)))
(assert (= body (str.split_at (str.split_rest input "|" 1) "|" 0)))
(assert (= footer (str.split_rest input "|" 2)))
; Second-level split of header by semicolon
(assert (>= (str.num_splits header ";") 2))
(declare-const version String)
(declare-const metadata String)
(assert (= version (str.split_at header ";" 0)))
(assert (= metadata (str.split_rest header ";" 1)))
; Third-level split of body by colon
(declare-const body_parts Int)
(assert (= body_parts (str.num_splits body ":")))
(assert (>= body_parts 4))
; Cross-component constraints
(assert (str.prefixof "v" version))
(assert (str.contains footer (str.at metadata 0)))
(assert (not (str.contains body version)))
; Length relationships
(assert (> (str.len body) (+ (str.len header) (str.len footer))))
; Type validation
(assert (str.is_digit (str.split_at body ":" 2)))
(assert (not (str.is_digit (str.substr footer 0 1))))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
