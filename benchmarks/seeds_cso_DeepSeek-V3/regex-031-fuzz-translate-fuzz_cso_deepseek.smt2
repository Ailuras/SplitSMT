(declare-const x String)
(declare-const y String)
(declare-const m String)
(declare-const n String)
(assert (= (str.++ x y) (str.++ m n)))
(assert (str.in_re n (re.* (str.to_re ""))))
(assert (> (str.len x) (str.len m)))

; --- LLM Generated Split Constraints ---
; Multi-delimiter splitting with nested dependencies
(declare-const s1 String)
(declare-const s2 String)
(assert (= (str.++ s1 s2) (str.++ m n)))
; First split by "|" with validation
(assert (str.contains s1 "|"))
(declare-const s1_parts Int)
(assert (= s1_parts (str.num_splits s1 "|")))
(assert (>= s1_parts 3))
(declare-const s1_part1 String)
(declare-const s1_part2 String)
(declare-const s1_part3 String)
(assert (= s1_part1 (str.split_at s1 "|" 0)))
(assert (= s1_part2 (str.split_at s1 "|" 1)))
(assert (= s1_part3 (str.split_rest s1 "|" 2)))
; Second split by ":" with cross-dependencies
(assert (str.contains s2 ":"))
(declare-const s2_part1 String)
(declare-const s2_part2 String)
(assert (= s2_part1 (str.split_at s2 ":" 0)))
(assert (= s2_part2 (str.split_rest s2 ":" 1)))
; Nested split of s1_part3 by "#"
(assert (str.contains s1_part3 "#"))
(declare-const s1_part3a String)
(declare-const s1_part3b String)
(assert (= s1_part3a (str.split_at s1_part3 "#" 0)))
(assert (= s1_part3b (str.split_rest s1_part3 "#" 1)))
; Complex validation constraints
(assert (>= (str.len s1_part2) (str.len s2_part1)))
(assert (str.prefixof s1_part1 s2_part2))
(assert (str.suffixof s1_part3b n))
(assert (distinct s1_part3a s2_part1))
(assert (< (str.indexof s1 "|" 0) (str.indexof s2 ":" 0)))
; Length relationships across splits
(assert (> (str.len s1_part3) (+ (str.len s1_part1) (str.len s1_part2))))
(assert (= (str.len s2) (+ (str.len s2_part1) (str.len s2_part2) 1)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
