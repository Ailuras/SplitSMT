(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (re.union (re.* (str.to_re "")) (str.to_re "l")))))
(assert (= (str.to_int x) 5))
(assert (not (= x "b")))
(assert (not (= x "A")))

; --- LLM Generated Split Constraints ---
; Multi-level split: split y by ":", then split the first part by "_"
(declare-const y_colon_count Int)
(assert (= y_colon_count (str.num_splits y ":")))
(assert (>= y_colon_count 2))
(declare-const y_first String)
(declare-const y_rest String)
(assert (= y_first (str.split_at y ":" 0)))
(assert (= y_rest (str.split_rest y ":" 1)))
(declare-const y_first_underscore_count Int)
(assert (= y_first_underscore_count (str.num_splits y_first "_")))
(assert (>= y_first_underscore_count 2))
(declare-const y_first_left String)
(declare-const y_first_right String)
(assert (= y_first_left (str.split_at y_first "_" 0)))
(assert (= y_first_right (str.split_rest y_first "_" 1)))
; Nested: split y_rest by "!"
(declare-const y_rest_excl_count Int)
(assert (= y_rest_excl_count (str.num_splits y_rest "!")))
(assert (>= y_rest_excl_count 2))
(declare-const y_rest_first String)
(declare-const y_rest_second String)
(assert (= y_rest_first (str.split_at y_rest "!" 0)))
(assert (= y_rest_second (str.split_rest y_rest "!" 1)))
; Cross-dependency: enforce y_first_right = y_rest_first reversed
; Advanced validation: lengths and containment
(assert (> (str.len y_first_left) 2))
(assert (str.contains y_rest_second y_first_left))
(assert (not (= y_first_left y_first_right)))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
