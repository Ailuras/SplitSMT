(declare-const x String)
(assert (str.in_re x (re.+ (str.to_re "YY"))))
(assert (> 2 (str.len x)))

; --- LLM Generated Split Constraints ---
; Basic split operations on string x with "Y" as delimiter
(assert (= (str.num_splits x "Y") 3)) ; Expect exactly 3 segments when splitting on "Y"
(assert (= (str.len (str.split_at x "Y" 0)) 1)) ; First segment should be single character
(assert (str.contains (str.split_rest x "Y" 1) "Y")) ; Remaining segments after first should contain delimiter
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
