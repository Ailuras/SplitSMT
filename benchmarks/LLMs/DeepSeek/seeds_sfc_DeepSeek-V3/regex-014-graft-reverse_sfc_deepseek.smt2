(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.* (str.to_re "ba"))))
(assert (str.in_re y (str.to_re "ba")))
(assert (= 2 (str.len x)))
(assert (= (str.len y) 4))

; --- LLM Generated Split Constraints ---
; Basic split operations on string x with delimiter "a"
(assert (= (str.num_splits x "a") 2)) ; Expect 2 segments when splitting "ba" by "a"
(assert (= (str.split_at x "a" 0) "b")) ; First segment should be "b"
(assert (= (str.split_at x "a" 1) "")) ; Second segment should be empty
; Split operations on string y with delimiter "b"
(assert (= (str.num_splits y "b") 2)) ; Expect 2 segments when splitting "baba" by "b"
(assert (= (str.split_at y "b" 0) "")) ; First segment should be empty
(assert (= (str.split_at y "b" 1) "a")) ; Second segment should be "a"
; Validation constraints
(assert (str.contains (str.split_rest y "a" 0) "b")) ; Remaining segments after first "a" should contain "b"
(assert (<= (str.len (str.split_at x "b" 0)) 1)) ; First segment length when splitting by "b" <= 1
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
