(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (re.++ (re.* (str.to_re "C")) (str.to_re """")))))
(assert (= (str.to_int x) 6))
(assert (not (= x "a&t")))
(assert (not (= x "V")))
(assert (not (= x "b")))

; --- LLM Generated Split Constraints ---
; Multi-delimiter hierarchical splitting with cross-validation
(declare-const input String)
(assert (str.contains input "|"))
(assert (str.contains input ";"))
(assert (> (str.len input) 25))
; First level split by pipe delimiter
(declare-const pipe_parts Int)
(assert (= pipe_parts (str.num_splits input "|")))
(assert (>= pipe_parts 3))
(declare-const segment1 String)
(declare-const segment2 String)
(declare-const segment3_rest String)
(assert (= segment1 (str.split_at input "|" 0)))
(assert (= segment2 (str.split_at input "|" 1)))
(assert (= segment3_rest (str.split_rest input "|" 2)))
; Second level splits with validation
(assert (str.contains segment1 ":"))
(declare-const key_val_pair Int)
(assert (= key_val_pair (str.num_splits segment1 ":")))
(assert (= key_val_pair 2))
(declare-const key String)
(declare-const value String)
(assert (= key (str.split_at segment1 ":" 0)))
(assert (= value (str.split_rest segment1 ":" 1)))
(assert (> (str.len key) 0))
(assert (> (str.len value) 2))
; Nested split with cross-segment constraints
(assert (str.contains segment2 ";"))
(declare-const subparts Int)
(assert (= subparts (str.num_splits segment2 ";")))
(assert (>= subparts 2))
(declare-const subpart1 String)
(declare-const subpart2_rest String)
(assert (= subpart1 (str.split_at segment2 ";" 0)))
(assert (= subpart2_rest (str.split_rest segment2 ";" 1)))
(assert (str.prefixof key subpart1))
; Complex length relationships
(assert (> (str.len segment3_rest) (+ (str.len segment1) (str.len segment2))))
(assert (distinct (str.len key) (str.len subpart1) (str.len value)))
; Final validation combining all splits
(assert (str.contains (str.++ key value) subpart2_rest))
(assert (not (str.contains segment3_rest ":")))
; --- End LLM Generated Constraints ---

(check-sat)

