(declare-const x String)
(declare-const y String)
(assert (str.in_re x (re.+ (re.++ (str.to_re "C-'\x0b'xX'\r'Lk0p<'\r'O:N'\t'Kw'\t'#{7^0' 'Pdr\\&2cTH") (str.to_re "w'\x0b'&OoLr")))))
(assert (= 8 (str.to_int x)))

; --- LLM Generated Split Constraints ---
; Multi-level splitting with constant delimiters
(declare-const input String)
(assert (= input "start:middle,part1-part2#end"))
; First split by "#" into exactly 2 parts
(assert (= (str.num_splits input "#") 2))
(declare-const left_part String)
(declare-const right_part String)
(assert (= left_part (str.split_at input "#" 0)))
(assert (= right_part (str.split_at input "#" 1)))
; Split left part by ":" into exactly 2 parts
(assert (= (str.num_splits left_part ":") 2))
(declare-const prefix String)
(declare-const middle_part String)
(assert (= prefix (str.split_at left_part ":" 0)))
(assert (= middle_part (str.split_at left_part ":" 1)))
; Split middle part by "," into exactly 2 parts
(assert (= (str.num_splits middle_part ",") 2))
(declare-const subpart1 String)
(declare-const subpart2 String)
(assert (= subpart1 (str.split_at middle_part "," 0)))
(assert (= subpart2 (str.split_at middle_part "," 1)))
; Split subpart2 by "-" into exactly 2 parts
(assert (= (str.num_splits subpart2 "-") 2))
(declare-const final1 String)
(declare-const final2 String)
(assert (= final1 (str.split_at subpart2 "-" 0)))
(assert (= final2 (str.split_at subpart2 "-" 1)))
; Cross-dependency constraints
(assert (str.prefixof prefix "sta"))
(assert (str.suffixof right_part "end"))
(assert (str.contains subpart1 "part"))
; Length relationships
(assert (> (str.len middle_part) (str.len prefix)))
(assert (< (str.len final1) (str.len final2)))
(assert (= (str.len input) (+ (str.len left_part) (str.len right_part) 1)))
; Validation constraints (without regex)
(assert (= (str.at final1 0) "#\p"))
(assert (= (str.at final2 1) "#\a"))
; --- End LLM Generated Constraints ---

(check-sat)

(exit)
