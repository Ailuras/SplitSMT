(declare-fun x7 () String)

(assert (str.in_re (str.++ x7 "z" x7) (re.* (str.to_re "z"))))
(assert (str.in_re x7 (re.* (re.range "a" "u"))))
(assert (not (str.in_re (str.++ x7 "z" x7 "b") (re.* (re.union (re.++ (str.to_re "b") (re.* (str.to_re "a")) (str.to_re "z")) (re.++ (str.to_re "b") (re.* (str.to_re "a")) (str.to_re "b")) (re.++ (str.to_re "a") (re.* (str.to_re "a")) (str.to_re "z")) (re.++ (str.to_re "a") (re.* (str.to_re "a")) (str.to_re "b")))))))
(assert (and (<= (str.len x7) 0) (<= 0 (str.len x7))))

(assert (str.in_re x7 (str.to_re "")))
(assert (= (+ (str.len x7) 0) 0))
(check-sat)
(exit)

