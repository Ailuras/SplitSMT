(declare-fun x0 () String)
(declare-fun x1 () String)

(assert (str.in_re x0 (re.* (str.to_re "b"))))
(assert (str.in_re x1 (re.* (str.to_re "a"))))
(assert (<= 0 (str.len x0)))

(assert (str.in_re x1 (re.* (str.to_re "a"))))
(assert (>= (+ (str.len x0) 0) 0))
(assert (>= (+ (str.len x1) 0) 0))
(assert (str.in_re x0 (re.* (str.to_re "b"))))
(check-sat)
(exit)

