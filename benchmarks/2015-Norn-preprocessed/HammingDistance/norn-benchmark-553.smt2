(declare-fun x8 () String)
(declare-fun x9 () String)

(assert (str.in_re (str.++ x8 "z" x9) re.none))
(assert (str.in_re x9 (re.* (re.range "a" "u"))))
(assert (str.in_re x8 (re.* (re.range "a" "u"))))
(assert (str.in_re (str.++ "b" x9) (re.* (re.range "a" "u"))))
(assert (str.in_re (str.++ "b" x8) (re.* (re.range "a" "u"))))
(assert (not (str.in_re (str.++ "b" x8 "z" "b" x9) re.none)))

(assert (= (+ (str.len x8) 0) 0))
(assert (= (+ (str.len x9) 0) 0))
(assert (str.in_re (str.++ x8 "z" x9) re.none))
(assert (str.in_re x8 (str.to_re "")))
(assert (str.in_re x9 (str.to_re "")))
(check-sat)
(exit)

