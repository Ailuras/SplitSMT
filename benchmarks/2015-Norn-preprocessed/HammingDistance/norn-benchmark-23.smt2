(declare-fun x5 () String)

(assert (not (str.in_re (str.++ "a" x5 "z" "a" x5) (re.* (str.to_re "z")))))
(assert (and (<= (str.len x5) 0) (<= 0 (str.len x5))))

(check-sat)
(exit)

