(declare-fun x1 () String)
(declare-fun x3 () String)
(declare-fun x5 () String)

(assert (str.in_re (str.++ x5 "z" x5) (re.* (str.to_re "z"))))
(assert (str.in_re x5 (re.* (re.range "a" "u"))))
(assert (and (and (and (<= (+ (str.len x1) (- 1)) 0) (<= 0 (+ (str.len x1) (- 1)))) (and (<= (+ (str.len x3) (- 1)) 0) (<= 0 (+ (str.len x3) (- 1))))) (and (<= (str.len x5) 0) (<= 0 (str.len x5)))))

(assert (= (+ (str.len x5) 0) 0))
(assert (str.in_re x5 (str.to_re "")))
(check-sat)
(exit)

