(declare-fun x9 () String)

(assert (str.in_re (str.++ x9 "z" x9) (re.* (str.to_re "z"))))
(assert (str.in_re x9 (re.* (re.range "a" "u"))))
(assert (not (str.in_re (str.++ "b" x9 "z" "a" x9) (re.++ (re.* (re.union (str.to_re "a") (re.++ (str.to_re "b") (re.* (re.union (str.to_re "b") (str.to_re "a"))) (str.to_re "z")))) (str.to_re "b") (re.* (re.union (str.to_re "b") (str.to_re "a")))))))
(assert (and (<= (str.len x9) 0) (<= 0 (str.len x9))))

(assert (str.in_re x9 (str.to_re "")))
(assert (= (+ (str.len x9) 0) 0))
(check-sat)
(exit)

