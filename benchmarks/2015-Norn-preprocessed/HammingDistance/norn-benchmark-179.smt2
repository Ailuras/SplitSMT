(declare-fun x3 () String)

(assert (str.in_re (str.++ x3 "z" x3) (re.* (str.to_re "z"))))
(assert (str.in_re x3 (re.* (re.range "a" "u"))))
(assert (and (<= (str.len x3) 0) (<= 0 (str.len x3))))

(assert (str.in_re x3 (str.to_re "")))
(assert (= (+ (str.len x3) 0) 0))
(check-sat)
(exit)

