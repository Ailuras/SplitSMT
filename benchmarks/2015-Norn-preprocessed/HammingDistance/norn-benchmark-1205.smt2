(declare-fun x7 () String)
(declare-fun x8 () String)

(assert (str.in_re (str.++ x7 "z" x8) re.none))
(assert (str.in_re x8 (re.* (re.range "a" "u"))))
(assert (str.in_re (str.++ x8 "b") (re.* (re.range "a" "u"))))
(assert (str.in_re x7 (re.* (re.range "a" "u"))))
(assert (not (str.in_re (str.++ x7 "z" x8 "b") re.none)))

(assert (= (+ (str.len x7) 0) 0))
(assert (str.in_re x8 (str.to_re "")))
(assert (str.in_re (str.++ x7 "z" x8) re.none))
(assert (= (+ (str.len x8) 0) 0))
(assert (str.in_re x7 (str.to_re "")))
(check-sat)
(exit)

