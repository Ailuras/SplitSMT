(declare-fun x4 () String)
(declare-fun x5 () String)

(assert (str.in_re (str.++ x4 "z" x5) re.none))
(assert (str.in_re x5 (re.* (re.range "a" "u"))))
(assert (str.in_re x5 (re.* (str.to_re "b"))))
(assert (str.in_re x4 (re.* (re.range "a" "u"))))
(assert (str.in_re x4 (re.* (str.to_re "a"))))
(assert (not (str.in_re "" re.none)))
(assert (<= 0 (str.len x5)))

(assert (str.in_re x4 (str.to_re "")))
(assert (= (+ (str.len x4) 0) 0))
(assert (not (str.in_re "" re.none)))
(assert (str.in_re x5 (str.to_re "")))
(assert (= (+ (str.len x5) 0) 0))
(assert (str.in_re (str.++ x4 "z" x5) re.none))
(check-sat)
(exit)

