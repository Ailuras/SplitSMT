(declare-fun x5 () String)

(assert (str.in_re (str.++ x5 "z" x5) (re.* (str.to_re "z"))))
(assert (str.in_re x5 (re.* (re.range "a" "u"))))
(assert (not (str.in_re (str.++ x5 "a") (re.* (re.range "a" "u")))))
(assert (and (<= (str.len x5) 0) (<= 0 (str.len x5))))

(assert false)
(check-sat)
(exit)

