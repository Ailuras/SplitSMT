(declare-fun x8 () String)

(assert (str.in_re (str.++ x7 "z" "b" x8) (re.union (re.* (re.union (str.to_re "z") (str.to_re "a") (str.to_re "c"))) (re.++ (re.* (re.union (str.to_re "z") (str.to_re "a") (str.to_re "c"))) (str.to_re "b") (re.* (re.union (str.to_re "b") (str.to_re "a") (str.to_re "c")))))))
(assert (str.in_re x8 (re.* (re.range "a" "u"))))
(assert (str.in_re (str.++ "b" x8) (re.* (re.range "a" "u"))))
(assert (str.in_re x7 (re.* (re.range "a" "u"))))
(assert (not (str.in_re (str.++ x7 "a") (re.* (re.range "a" "u")))))

(assert false)
(check-sat)
(exit)

