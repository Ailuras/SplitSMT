(declare-fun x4 () String)

(assert (str.in_re (str.++ x4 "z") (re.union (re.* (re.union (str.to_re "z") (str.to_re "a") (str.to_re "c"))) (re.++ (re.* (re.union (str.to_re "z") (str.to_re "a") (str.to_re "c"))) (str.to_re "b") (re.* (re.union (str.to_re "b") (str.to_re "a") (str.to_re "c")))))))
(assert (str.in_re "" (re.* (re.range "a" "u"))))
(assert (str.in_re x4 (re.* (re.range "a" "u"))))
(assert (not (str.in_re x4 (str.to_re ""))))

(assert (str.in_re x4 (re.* (re.union (str.to_re "a") (str.to_re "c")))))
(assert (str.in_re x4 (re.* (re.union (str.to_re "a") (str.to_re "c")))))
(assert (>= (+ (str.len x4) 0) 0))
(assert (not (str.in_re x4 (str.to_re ""))))
(check-sat)
(exit)

