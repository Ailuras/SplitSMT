(declare-fun x4 () String)

(assert (str.in_re (str.++ x4 "z") (re.* (re.union (re.++ (str.to_re "z") (str.to_re "z")) (re.++ (str.to_re "a") (str.to_re "z")) (re.++ (str.to_re "c") (str.to_re "z"))))))
(assert (str.in_re "" (re.* (re.range "a" "u"))))
(assert (str.in_re x4 (re.* (re.range "a" "u"))))
(assert (not (str.in_re x4 re.none)))

(assert (>= (+ (str.len x4) 0) 0))
(assert (str.in_re x4 (re.* (re.union (str.to_re "a") (str.to_re "c")))))
(assert (or (not (str.in_re x4 (str.to_re "c"))) (= (- (str.len x4) 1) 0)))
(assert (or (str.in_re x4 (str.to_re "a")) (str.in_re x4 (str.to_re "c"))))
(assert (or (not (str.in_re x4 (str.to_re "a"))) (= (- (str.len x4) 1) 0)))
(assert (not (str.in_re x4 re.none)))
(check-sat)
(exit)

