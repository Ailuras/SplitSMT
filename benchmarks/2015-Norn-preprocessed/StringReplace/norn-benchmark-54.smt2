(declare-fun x9 () String)
(declare-fun x10 () String)

(assert (str.in_re (str.++ x9 "z" "b" x10) (re.* (re.union (str.to_re "z") (str.to_re "a") (str.to_re "c")))))
(assert (str.in_re (str.++ "b" x10) (re.* (re.range "a" "u"))))
(assert (str.in_re x9 (re.* (re.range "a" "u"))))
(assert (str.in_re x10 (re.* (re.range "a" "u"))))
(assert (str.in_re (str.++ x9 "a") (re.* (re.range "a" "u"))))
(assert (not (str.in_re (str.++ x9 "a" "z" x10) re.none)))

(assert false)
(check-sat)
(exit)

