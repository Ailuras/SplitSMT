(declare-fun x5 () String)
(declare-fun x6 () String)

(assert (str.in_re (str.++ x5 "z" "b" x6) (re.union (re.* (re.union (str.to_re "z") (str.to_re "a") (str.to_re "c"))) (re.++ (re.* (re.union (str.to_re "z") (str.to_re "a") (str.to_re "c"))) (str.to_re "b") (re.* (re.union (str.to_re "b") (str.to_re "a") (str.to_re "c")))))))
(assert (str.in_re (str.++ "b" x6) (re.* (re.range "a" "u"))))
(assert (str.in_re x5 (re.* (re.range "a" "u"))))

(assert (str.in_re x6 (re.* (re.union (str.to_re "a") (str.to_re "b") (str.to_re "c")))))
(assert (str.in_re x5 (re.* (re.union (str.to_re "a") (str.to_re "c")))))
(assert (>= (+ (str.len x5) 0) 0))
(assert (str.in_re x5 (re.* (re.union (str.to_re "a") (str.to_re "c")))))
(assert (>= (+ (str.len x6) 0) 0))
(check-sat)
(exit)

