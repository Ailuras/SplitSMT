(declare-fun x0 () String)
(declare-fun i13 () Int)

(assert (str.in_re x0 (re.* (str.to_re "b"))))
(assert (str.in_re x0 (str.to_re "")))
(assert (str.in_re x0 (re.* (re.range "a" "u"))))
(assert (not (str.in_re x0 (re.++ (re.* (str.to_re "a")) (str.to_re "b") (re.* (str.to_re "b"))))))
(assert (and (<= 0 (str.len x0)) (= (* i13 2) (+ (str.len x0) 2))))

(assert (str.in_re x0 (str.to_re "")))
(assert (= (+ (str.len x0) 0) 0))
(check-sat)
(exit)

