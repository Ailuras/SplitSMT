(declare-fun x4 () String)
(declare-fun i13 () Int)

(assert (str.in_re x4 (str.to_re "")))
(assert (str.in_re x4 (re.* (re.range "a" "u"))))
(assert (str.in_re x4 (re.* (str.to_re "b"))))
(assert (not (str.in_re (str.++ "a" x4 "b") (re.++ (str.to_re "a") (re.* (str.to_re "b"))))))
(assert (and (<= 0 (str.len x4)) (= (* i13 2) (+ (str.len x4) 2))))

(assert false)
(check-sat)
(exit)

