(declare-fun x4 () String)

(assert (str.in_re x4 (re.* (re.range "a" "u"))))
(assert (str.in_re x4 (re.* (str.to_re "b"))))
(assert (not (str.in_re (str.++ "a" x4 "b") (re.* (str.to_re "b")))))

(assert (>= (+ (str.len x4) 0) 0))
(assert (str.in_re x4 (re.* (str.to_re "b"))))
(check-sat)
(exit)

