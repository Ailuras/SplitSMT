(assert (not (= x4 (str.++ x4_l0 "a" x4_r0))))
(assert (not (str.in_re x4 (re.++ (re.* (str.to_re "a")) (str.to_re "b") (re.* (str.to_re "b"))))))
(assert (>= (- (str.len x4) 1) 0))
(assert (not (= x4 (str.++ x4_l1 "b" x4_r1))))
(assert (or (not (str.in_re x4_r2 (re.* (str.to_re "b")))) (str.in_re x4_r2 (re.* (re.union (str.to_re "a") (str.to_re "b"))))))
(assert (str.in_re x4 (re.++ (str.to_re "a") (re.* (str.to_re "b")))))
(assert (not (str.in_re x4 (re.* (str.to_re "a")))))
(assert (or (not (str.in_re x4_r2 (re.* (str.to_re "a")))) (str.in_re x4_r2 (re.* (re.union (str.to_re "a") (str.to_re "b"))))))
(assert (>= (+ (str.len x4) 0) 0))
(assert (not (= x4 (str.++ x4_l2 "a" x4_r2))))
(assert (str.in_re x4 (re.++ (str.to_re "a") (re.* (re.union (str.to_re "a") (str.to_re "b"))))))
