(assert (str.in_re x4 (re.* (re.union (str.to_re "a") (str.to_re "b")))))
(assert (or (not (str.in_re x4_r1 (re.* (str.to_re "b")))) (str.in_re x4_r1 (re.* (re.union (str.to_re "a") (str.to_re "b"))))))
