(declare-fun x3 () String)
(declare-fun x4 () String)

(assert (str.in_re (str.++ x3 "z" x4) (re.* (re.union (str.to_re "z") (str.to_re "a") (str.to_re "b") (str.to_re "c")))))
(assert (str.in_re x4 (re.* (re.range "a" "u"))))
(assert (str.in_re x3 (re.* (re.range "a" "u"))))
(assert (<= 0 (str.len x3)))

(assert (str.in_re x3 (re.* (re.union (str.to_re "a") (str.to_re "b") (str.to_re "c")))))
(assert (str.in_re x4 (re.* (re.union (str.to_re "a") (str.to_re "b") (str.to_re "c")))))
(assert (>= (+ (str.len x3) 0) 0))
(assert (>= (+ (str.len x4) 0) 0))
(check-sat)
(exit)

