(declare-fun x3 () String)
(declare-fun x4 () String)

(assert (str.in_re (str.++ x3 "z" x4) (re.* (str.to_re "z"))))
(assert (str.in_re x4 (re.* (re.range "a" "u"))))
(assert (str.in_re x3 (re.* (re.range "a" "u"))))
(assert (not (str.in_re x3 (str.to_re ""))))
(assert (<= 0 (str.len x3)))

(assert false)
(check-sat)
(exit)

